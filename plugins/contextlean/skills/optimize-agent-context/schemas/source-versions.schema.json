{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextlean.dev/schemas/source-versions.schema.json",
  "title": "ContextLean current canonical source versions",
  "type": "object",
  "required": ["schema", "versions"],
  "properties": {
    "schema": { "const": "contextlean.source-versions/v1" },
    "versions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
      "additionalProperties": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$" }
    }
  },
  "additionalProperties": false
}
